// FluidNinja Buoyancy: the water under every floating body, resampled in one pass onto that body's own grid (i along +X, j along +Y).
// Height from the Surface Mirror (an orthographic depth capture of the drawn water, without FluidNinja Waves' height); current from
// FluidNinja's velocity buffer; and, with FluidNinja Waves, the waves the body feels: B - B_self, the simulation's B = eta + P
// (RT_PressureDivergence's z) less the body's own field B_self (its tile of the self-field atlas, FluidNinjaBuoyancyWaveSource.usf), both read
// bilinearly at the same point with the same weights (the self field's cells are the simulation's own). Dispatched from
// FluidNinjaBuoyancyGather.cpp; read back once a frame for all bodies.

#include "/Engine/Public/Platform.ush"

Texture2D<float> HeightTexture;
Texture2D<float4> FlowTexture;
Texture2D<float4> WaveTexture;           // RT_PressureDivergence of the group's simulation (B in z), when it runs FluidNinja Waves
Texture2D<float> SelfTexture;            // the self-field atlas (R16F: B_self)
// Per body, six: (height column, row, step, grid points across), (flow column, row, step, flow on), (first sample, -, -, -),
// (wave column, row, step, waves on), (self atlas column, row, step, self cells across), (self tile column, row, sponge cells, -).
StructuredBuffer<float4> Slots;
RWStructuredBuffer<float4> Samples;      // per point: (height or NoWater, flow u, flow v, B - B_self or 0)
int2 HeightSize;
int2 FlowSize;
int2 WaveSize;
int NumSlots;
float CaptureTop;
float CaptureFar;
int HasFlow;
int HasWave;

static const int SlotStride = 6;

static const float NoWater = -1.0e30;

// Bilinear over the drawn texels only (depth inside (0, CaptureFar)): a bank or rock beside the water does not drag the height down.
float SampleHeight(float2 T)
{
	const int2 P0 = int2(floor(T));
	const float2 F = T - float2(P0);
	float Weight = 0.0;
	float Sum = 0.0;
	[unroll]
	for (int K = 0; K < 4; ++K)
	{
		const int2 O = int2(K & 1, K >> 1);
		const int2 P = clamp(P0 + O, int2(0, 0), HeightSize - 1);
		const float Depth = HeightTexture.Load(int3(P, 0));
		const float W = (O.x != 0 ? F.x : 1.0 - F.x) * (O.y != 0 ? F.y : 1.0 - F.y);
		if (Depth > 0.0 && Depth < CaptureFar)
		{
			Weight += W;
			Sum += (CaptureTop - Depth) * W;
		}
	}
	return Weight > 0.3 ? Sum / Weight : NoWater;
}

// B (cm) at texel coordinates T of the wave texture (texel centres at integers), bilinear with its texels clamped.
float SampleWave(float2 T)
{
	const int2 P0 = int2(floor(T));
	const float2 F = T - float2(P0);
	float Sum = 0.0;
	[unroll]
	for (int K = 0; K < 4; ++K)
	{
		const int2 O = int2(K & 1, K >> 1);
		const int2 P = clamp(P0 + O, int2(0, 0), WaveSize - 1);
		const float W = (O.x != 0 ? F.x : 1.0 - F.x) * (O.y != 0 ? F.y : 1.0 - F.y);
		Sum += WaveTexture.Load(int3(P, 0)).z * W;
	}
	return Sum;
}

// B_self (cm) at atlas texel coordinates T, bilinear over the body's own tile only (Tile = its first texel, Cells across): the same
// weights as SampleWave's at the same point, since the self field's cells are the simulation's own, shifted by whole cells.
float SampleSelf(float2 T, int2 Tile, int Cells)
{
	const int2 P0 = int2(floor(T));
	const float2 F = T - float2(P0);
	float Sum = 0.0;
	[unroll]
	for (int K = 0; K < 4; ++K)
	{
		const int2 O = int2(K & 1, K >> 1);
		const int2 P = P0 + O;
		if (all(P >= Tile) && all(P < Tile + Cells))
		{
			const float W = (O.x != 0 ? F.x : 1.0 - F.x) * (O.y != 0 ? F.y : 1.0 - F.y);
			Sum += SelfTexture.Load(int3(P, 0)) * W;
		}
	}
	return Sum;
}

float4 SampleFlow(float2 T)
{
	const int2 P0 = int2(floor(T));
	const float2 F = T - float2(P0);
	float4 Sum = 0.0;
	[unroll]
	for (int K = 0; K < 4; ++K)
	{
		const int2 O = int2(K & 1, K >> 1);
		const int2 P = clamp(P0 + O, int2(0, 0), FlowSize - 1);
		const float W = (O.x != 0 ? F.x : 1.0 - F.x) * (O.y != 0 ? F.y : 1.0 - F.y);
		Sum += FlowTexture.Load(int3(P, 0)) * W;
	}
	return Sum;
}

[numthreads(8, 8, 1)]
void GatherCS(uint3 Id : SV_DispatchThreadID)
{
	const int Slot = int(Id.z);
	if (Slot >= NumSlots)
	{
		return;
	}
	const float4 A = Slots[Slot * SlotStride];
	const float4 B = Slots[Slot * SlotStride + 1];
	const float4 C = Slots[Slot * SlotStride + 2];
	const float4 D = Slots[Slot * SlotStride + 3];
	const float4 E = Slots[Slot * SlotStride + 4];
	const float4 G = Slots[Slot * SlotStride + 5];
	const int Grid = int(A.w);
	const int I = int(Id.x);
	const int J = int(Id.y);
	if (I >= Grid || J >= Grid)
	{
		return;
	}
	// Capture texels: column along +Y, row along -X (looking straight down). Velocity texels: column along +X, row along +Y.
	const float Height = SampleHeight(float2(A.x + J * A.z, A.y - I * A.z));
	float4 Flow = 0.0;
	const float2 T = float2(B.x + I * B.z, B.y + J * B.z);
	if (HasFlow != 0 && B.w > 0.5 && all(T >= -0.5) && all(T <= float2(FlowSize) - 0.5))
	{
		Flow = SampleFlow(T);
	}
	// The waves the body feels, where its own field is known and clear of that field's sponge (0 elsewhere: the hull lies well inside it).
	float Wave = 0.0;
	if (HasWave != 0 && D.w > 0.5)
	{
		const int Cells = int(E.w);
		const int2 Tile = int2(G.xy);
		const float2 TS = float2(E.x + I * E.z, E.y + J * E.z);
		const float2 Local = TS - float2(Tile);
		if (all(Local >= G.z - 0.5) && all(Local <= float(Cells) - G.z - 0.5))
		{
			Wave = SampleWave(float2(D.x + I * D.z, D.y + J * D.z)) - SampleSelf(TS, Tile, Cells);
		}
	}
	Samples[int(C.x) + J * Grid + I] = float4(Height, Flow.x, Flow.y, Wave);
}
